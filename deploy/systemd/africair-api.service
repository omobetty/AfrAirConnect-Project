[Unit]
Description=AfricAir API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=africair
Group=africair
WorkingDirectory=/opt/africair/api/current
EnvironmentFile=/etc/africair/api.env
EnvironmentFile=-/opt/africair/api/current/version.env
Environment=PORT=4000
Environment=ADMIN_TOKEN_FILE=%d/admin_token
Environment=PROMO_CODES_FILE=%d/promo_codes
Environment=DATABASE_URL_FILE=%d/database_url
LoadCredential=admin_token:/etc/africair/secrets/admin_token
LoadCredential=promo_codes:/etc/africair/secrets/promo_codes
LoadCredential=database_url:/etc/africair/secrets/database_url
ExecStart=/usr/bin/node /opt/africair/api/current/dist/index.js
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=20s
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target